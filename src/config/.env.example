# ====================================================================
# BIẾN MÔI TRƯỜNG DỰ ÁN (ENVIRONMENT VARIABLES)
# Tạo bản sao file này thành .env trên máy của bạn và điền thông số thật
# ====================================================================

# Cổng khởi chạy Server Backend
PORT=3000

# Cấu hình Cơ sở dữ liệu (MySQL / MariaDB trên Hosting hoặc Localhost)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lau_mam_tram_ruoi

# Mật khẩu đăng nhập dành cho Quản trị viên (Admin CMS)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@123

